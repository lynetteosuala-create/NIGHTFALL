# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret used to sign account session tokens on the backend.
SESSION_SECRET="nightfall-local-dev-secret-change-in-prod"

# Optional SMTP configuration for dispatching real email verification codes.
# When omitted, the server generates and verifies codes in-memory/file store and provides a secure in-app verification inbox fallback.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
